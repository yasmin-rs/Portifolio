# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# ---------- Cenário 1: desenvolvimento (modelo local via Ollama, custo zero) ----------
MODEL_NAME=ollama/qwen2.5:7b
API_BASE=http://localhost:11434

# ---------- Cenário 2: produção/demo (API da Anthropic) ----------
# MODEL_NAME=anthropic/<modelo-claude>
# API_BASE=
# ANTHROPIC_API_KEY=sk-ant-...

# Segundo modelo usado apenas pelo script de comparação (local x API)
# vários modelos: separe por vírgula, ex.: gemini/gemini-3.5-flash-lite,anthropic/claude-haiku-5-5
COMPARE_MODEL_NAME=

# ---------- Parâmetros da chamada ----------
TEMPERATURE=0
MAX_TOKENS=600
# Versão do prompt do classificador usada pelos agentes (ver prompts/ e outputs/avaliacao/)
CLASSIFIER_PROMPT_VERSION=v2
# Modelo local em CPU é lento (prompts longos > 2 min na 1ª chamada): use 300+
REQUEST_TIMEOUT=300
JSON_MAX_RETRIES=2

# ---------- Dados ----------
RAW_CSV=data/raw/McDonald_s_Reviews.csv
SAMPLE_SIZE=500
SEED=42

# ---------- Automação / alertas ----------
ALERT_WEBHOOK_URL=

# ---------- Dashboard ----------
ENABLE_LIVE_QA=false
LIVE_QA_MAX_PER_SESSION=5
